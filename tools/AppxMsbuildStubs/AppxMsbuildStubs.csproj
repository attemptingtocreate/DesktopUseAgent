<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Microsoft.Build.AppxPackage</AssemblyName>
    <RootNamespace>Microsoft.Build.AppxPackage</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.8.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.8.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- Also emit Pri tasks DLL expected beside AppxPackage -->
  <Target Name="BuildPriTasksDll" AfterTargets="Build">
    <PropertyGroup>
      <_PriOut>$(OutputPath)Microsoft.Build.Packaging.Pri.Tasks.dll</_PriOut>
    </PropertyGroup>
    <Csc Sources="@(Compile)"
         OutputAssembly="$(_PriOut)"
         TargetType="library"
         References="@(ReferencePath)"
         Nullable="enable"
         LangVersion="latest"
         Condition="false" />
    <!-- Duplicate Appx assembly as Pri tasks assembly; both namespaces live in one DLL for stubs. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(_PriOut)" SkipUnchangedFiles="true" />
  </Target>
</Project>
