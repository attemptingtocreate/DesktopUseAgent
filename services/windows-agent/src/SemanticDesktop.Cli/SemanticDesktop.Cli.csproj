  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SemanticDesktop.Core\SemanticDesktop.Core.csproj" />
    <ProjectReference Include="..\SemanticDesktop.IPC\SemanticDesktop.IPC.csproj" />
  </ItemGroup>
</Project>
